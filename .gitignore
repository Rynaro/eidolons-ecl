# Editor / OS noise
.DS_Store
*.swp
*.swo
*~

# Test scratch
/tmp-*
*.bak

# bats output
.bats-tmp/

# Generated by examples/*/run.sh — regenerated on every run.
# (Conformance fixtures under conformance/tests/ are committed deliberately
# and unaffected by these patterns.)
# v2 sibling envelopes (*.v2.envelope.json) are committed reference artefacts
# and are excluded from the run-time regeneration pattern below.
examples/*/.eidolons/
examples/*/*.envelope.json
!examples/*/*.v2.envelope.json
examples/apivr-vigil-escalation/ack.md
